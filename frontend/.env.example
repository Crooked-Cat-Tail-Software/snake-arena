# Copy to .env(.local) to override where the frontend looks for the API.
# Unset / default: http://localhost:8000 (matches `npm run dev` next to a
# separately-running backend). The Docker build sets this to an empty
# string at build time, so the built app calls the API on its own origin
# instead (the backend serves this frontend itself -- see ../Dockerfile).
VITE_API_BASE_URL=http://localhost:8000
