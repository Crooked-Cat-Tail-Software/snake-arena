{
  "uid": "snake-arena",
  "title": "Snake Arena \u2014 game metrics",
  "tags": [
    "snake-arena"
  ],
  "description": "Game metrics from CloudWatch (namespace SnakeArena), filterable by environment and deployed version.",
  "timezone": "browser",
  "refresh": "1m",
  "schemaVersion": 41,
  "editable": true,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "cloudwatch",
          "uid": "cloudwatch"
        },
        "refresh": 2,
        "sort": 1,
        "query": {
          "refId": "env",
          "queryType": "dimensionValues",
          "namespace": "SnakeArena",
          "region": "default",
          "metricName": "leaderboard.reads",
          "dimensionKey": "deployment.environment.name",
          "dimensionFilters": {}
        },
        "multi": false,
        "includeAll": false,
        "current": {},
        "options": []
      },
      {
        "name": "version",
        "label": "Version",
        "type": "query",
        "datasource": {
          "type": "cloudwatch",
          "uid": "cloudwatch"
        },
        "refresh": 2,
        "sort": 1,
        "query": {
          "refId": "version",
          "queryType": "dimensionValues",
          "namespace": "SnakeArena",
          "region": "default",
          "metricName": "leaderboard.reads",
          "dimensionKey": "service.version",
          "dimensionFilters": {
            "deployment.environment.name": "$env"
          }
        },
        "multi": true,
        "includeAll": true,
        "current": {},
        "options": [],
        "allValue": "*"
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Games finished",
      "description": "Accepted scores in the time range, all selected versions.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "namespace": "SnakeArena",
          "metricName": "scores.submitted",
          "region": "default",
          "dimensions": {
            "deployment.environment.name": "$env",
            "service.version": "$version"
          },
          "matchExact": true,
          "statistic": "Sum",
          "period": "",
          "id": "",
          "expression": "",
          "label": "${PROP('Dim.service.version')}"
        }
      ],
      "transformations": [
        {
          "id": "calculateField",
          "options": {
            "mode": "reduceRow",
            "reduce": {
              "reducer": "sum"
            },
            "replaceFields": true,
            "alias": "Games finished"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "id": 1
    },
